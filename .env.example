# Prisma connection string (SQLite). In Prisma 7+, the path is relative to prisma.config.ts
# (apps/backend/), so ./prisma/dev.db lives at apps/backend/prisma/dev.db (ignored by git).
DATABASE_URL="file:./prisma/dev.db"

# Backend API port (docs/architecture/overview.md: backend serves http://localhost:3001).
PORT=3001

# Allowed origin for CORS (Vite dev server, http://localhost:5173).
CORS_ORIGIN=http://localhost:5173