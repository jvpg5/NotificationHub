# Prisma connection string (SQLite). Path is relative to apps/backend/prisma/schema.prisma,
# so the database file lives at apps/backend/prisma/dev.db (ignored by git).
DATABASE_URL="file:./dev.db"

# Backend API port (docs/architecture/overview.md: backend serves http://localhost:3001).
PORT=3001

# Allowed origin for CORS (Vite dev server, http://localhost:5173).
CORS_ORIGIN=http://localhost:5173